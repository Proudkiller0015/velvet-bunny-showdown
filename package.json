{
  "name": "velvet-bunny-showdown",
  "version": "1.0.0",
  "description": "A hosted Pokemon Showdown server whose resident bot accepts a challenge in any format, builds a legal team for it, and plays a decent game.",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup": "node scripts/setup-config.js",
    "postinstall": "node scripts/rebuild-native.js && node scripts/setup-config.js",
    "test": "node test/teams.test.js && node test/behaviour.test.js && node test/ai.test.js 20 gen9ou",
    "test:teams": "node test/teams.test.js",
    "test:ai": "node test/ai.test.js",
    "test:behaviour": "node test/behaviour.test.js",
    "test:difficulty": "node test/difficulty.test.js",
    "test:live": "node test/live.test.js",
    "ablate": "node test/ablation.js",
    "test:remote": "node test/remote.test.js",
    "test:lobby": "node test/lobby.test.js",
    "test:opponent": "node test/opponent.test.js",
    "test:nosack": "node test/nosack.test.js",
    "test:crashfree": "node test/crashfree.test.js gen9rpbattle 25",
    "test:rpformats": "node test/rp-formats.test.js",
    "test:unaware": "node test/unaware.test.js",
    "test:ourstuff": "node test/ourstuff.test.js",
    "train": "node test/train.js",
    "test:elo": "node test/elo.test.js",
    "marathon": "node test/marathon.js",
    "marathon:stop": "node test/marathon.js --stop",
    "build:calc": "node scripts/build-calc-data.js && node scripts/build-calc-page.js",
    "test:calc": "node scripts/check-calc.js",
    "deploy": "node scripts/deploy.js"
  },
  "keywords": [
    "pokemon",
    "pokemon-showdown",
    "bot",
    "ai",
    "teambuilder"
  ],
  "license": "MIT",
  "dependencies": {
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@smogon/calc": "^0.11.0",
    "better-sqlite3": "^13.0.3",
    "pokemon-showdown": "^0.11.11",
    "redis": "^6.2.1",
    "ws": "^8.21.3"
  },
  "homepage": "https://velvet-bunny-showdown.onrender.com"
}
